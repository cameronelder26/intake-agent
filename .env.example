# Copy to .env (git-ignored) or export these. Nothing here is required for --mock runs.
ANTHROPIC_API_KEY=
INTAKE_MODEL=claude-haiku-5-5
INTAKE_EFFORT=low
INTAKE_THRESHOLD=0.85
INTAKE_STATE_DIR=.intake
INTAKE_REVIEWER=
INTAKE_KILL_SWITCH=
# Unset = in-memory vector store. Matches docker-compose.yml's local-only default.
INTAKE_PG_DSN=
# Eval harness price override, USD per million tokens. Unset = model rate in config.py.
INTAKE_PRICE_IN=
INTAKE_PRICE_OUT=
